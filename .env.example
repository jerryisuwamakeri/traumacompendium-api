# Copy this file to .env for local development.
# In staging/production these are real environment variables — no .env file is read.

# ---- App ----
APP_ENV=development            # development | staging | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=info                 # debug | info | warn | error

# ---- Database (MySQL) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=trauma_app
DB_PASSWORD=change-me
DB_NAME=trauma_compendium
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# ---- Redis ----
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=traumacompendium-api

# ---- OTP (email + phone verification) ----
OTP_LENGTH=6
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5

# ---- Termii (SMS / phone OTP) ----
# TERMII_MODE=sandbox logs the message instead of calling Termii's live API.
# Switch to "production" (with a real TERMII_API_KEY) to send real SMS.
TERMII_MODE=sandbox
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=TraumaComp

# ---- SMTP (transactional email) ----
# SMTP_MODE=sandbox logs the email instead of sending it.
SMTP_MODE=sandbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@traumacompendium.app
SMTP_FROM_NAME=TraumaCompendium

# ---- Text-to-speech (lesson audio) ----
# TTS_MODE=sandbox returns a placeholder silent clip instead of calling a
# real provider. Switch to "production" (with a real TTS_API_KEY) to call
# Google Cloud Text-to-Speech for real.
TTS_MODE=sandbox
TTS_BASE_URL=https://texttospeech.googleapis.com
TTS_API_KEY=

# ---- HTTP / CORS / rate limiting ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_GRACE_PERIOD=15s
